# NEXUS V4 — Memory Core
# Os dados são salvos localmente em .nexus-data/ (memory.json, conversations.json, timeline.json)

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096

# v0 — use o model ID disponível na sua conta/API v0
V0_API_KEY=
V0_MODEL=

# NotebookLM — opcional: bridge seu, se quiser conectar notebooks
NOTEBOOKLM_BRIDGE_URL=
NOTEBOOKLM_BRIDGE_TOKEN=
NOTEBOOKLM_NOTEBOOK_ID=

PORT=8787
